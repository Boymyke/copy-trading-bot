# GoldBot - set these in Railway (Variables tab), never in chat or in git.

# MetaApi API token (app.metaapi.cloud -> API access). Required to trade.
METAAPI_TOKEN=
# Telegram bot token from @BotFather. Required for messages and commands.
TELEGRAM_BOT_TOKEN=

# One-time code: send "/pair <code>" to the bot to connect your chat.
PAIR_CODE=
# Or set the chat id directly instead of pairing.
TELEGRAM_CHAT_ID=

# MT5 login of the trading account; the MetaApi account id is looked up from it.
EXNESS_LOGIN=224085839
# Optional: skip the lookup.
METAAPI_ACCOUNT_ID=

SYMBOL=XAUUSDm
DATA_DIR=/data
# Seconds between position reads while a trade is open (30 stays inside MetaApi's limits).
POLL_OPEN_SECONDS=30
MAX_SPREAD=0.80
MAX_LOT=0.50
LOG_LEVEL=INFO
