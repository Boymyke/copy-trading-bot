# Gold Copy Trader v4 — cloud-only architecture
# Mission-critical trade replication runs inside MetaApi CopyFactory.
# Railway is the control, Telegram, dashboard and target-risk layer.

METAAPI_TOKEN=
METAAPI_SOURCE_ACCOUNT_ID=
METAAPI_TARGET_ACCOUNT_ID=
TELEGRAM_BOT_TOKEN=
DASHBOARD_PASSWORD=
TELEGRAM_PAIRING_CODE=
DATA_DIR=/data

# CopyFactory route
COPY_SYMBOL=XAUUSD
TARGET_SYMBOL=XAUUSD
COPYFACTORY_STRATEGY_NAME=Ferrn Gold Copier
DEFAULT_LOT=0.01

# Target-side independent risk settings (USD per 0.01 lot)
DEFAULT_INITIAL_SL_USD=0.60
DEFAULT_TRAIL_TRIGGER_USD=0.50
DEFAULT_TRAIL_GAP_USD=0.20
DEFAULT_TRAIL_STEP_USD=0.10

# Controller polling. This does NOT control CopyFactory copying latency.
# CopyFactory performs source->target replication natively.
CONTROLLER_POLL_SECONDS=1.0
TELEGRAM_POLL_TIMEOUT=25
