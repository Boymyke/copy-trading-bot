# Gold Copy Trader v5 — CopyFactory + REST dry-run risk monitor
# Trade replication runs inside MetaApi CopyFactory. Railway only monitors,
# controls pause/lot, and simulates the target-side SL/trailing rules.
# The risk manager is DRY RUN by construction: it has no code that sends orders.

METAAPI_TOKEN=
METAAPI_SOURCE_ACCOUNT_ID=
METAAPI_TARGET_ACCOUNT_ID=
# Region host of the trading-terminal REST API (must match the target account region)
METAAPI_REST_BASE_URL=https://mt-client-api-v1.london.agiliumtrade.ai

TELEGRAM_BOT_TOKEN=
# Code to send as "/pair <code>" the first time. Falls back to DASHBOARD_PASSWORD.
TELEGRAM_PAIRING_CODE=
# Dashboard login: user "trader", this password
DASHBOARD_PASSWORD=
DATA_DIR=/data

# CopyFactory route (existing strategy is adopted, never created or overwritten)
COPY_SYMBOL=XAUUSD.f
TARGET_SYMBOL=XAUUSDm
COPYFACTORY_STRATEGY_NAME=Gold Source Strategy
DEFAULT_LOT=0.01

# Simulated target risk (USD per 0.01 lot). Seeded into /data once; Telegram edits win.
DEFAULT_INITIAL_SL_USD=0.60
DEFAULT_TRAIL_TRIGGER_USD=0.50
DEFAULT_TRAIL_GAP_USD=0.20
DEFAULT_TRAIL_STEP_USD=0.10

# Polling
CONTROLLER_POLL_SECONDS=0.5
COPYFACTORY_REFRESH_SECONDS=30
METAAPI_REST_TIMEOUT_SECONDS=15
SPEC_CACHE_SECONDS=600
# Consecutive position reads a managed trade must be missing before it counts as closed
CLOSE_CONFIRM_POLLS=2
# Telegram floating P/L update interval per open trade (0 disables)
TELEGRAM_PNL_UPDATE_SECONDS=60
TELEGRAM_POLL_TIMEOUT=25

# Positions opened with these MT5 reasons are treated as manual and never managed
MANAGED_EXCLUDE_REASONS=POSITION_REASON_CLIENT,POSITION_REASON_MOBILE,POSITION_REASON_WEB
LOG_LEVEL=INFO
