# SOURCE TERMINAL
SOURCE_MT5_PATH=C:\\Program Files\\MetaTrader 5 Source\\terminal64.exe
SOURCE_LOGIN=0
SOURCE_PASSWORD=
SOURCE_SERVER=

# TARGET TERMINAL
TARGET_MT5_PATH=C:\\Program Files\\MetaTrader 5 Target\\terminal64.exe
TARGET_LOGIN=0
TARGET_PASSWORD=
TARGET_SERVER=

# Copy only these source symbols (comma-separated)
SOURCE_SYMBOLS=XAUUSD,GOLD

# source:target mappings (comma-separated)
TARGET_SYMBOL_MAP=XAUUSD:XAUUSD,GOLD:GOLD

# Polling / safety
POLL_INTERVAL_SECONDS=1.0
SOURCE_STATE_MAX_AGE_SECONDS=5
DRY_RUN=true
MAGIC_NUMBER=26051001
COMMENT_PREFIX=FerrnCopier

# Lot sizing: fixed | source_multiplier | risk_percent
LOT_MODE=fixed
FIXED_LOT=0.01
LOT_MULTIPLIER=1.0
RISK_PERCENT=1.0

# Target-side protection in MT5 points. 0 disables that protection.
SL_POINTS=500
TP_POINTS=1000
DEVIATION_POINTS=30
