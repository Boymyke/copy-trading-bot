# Gold Copy Trader — MetaApi CopyFactory executes, Railway monitors.

METAAPI_TOKEN=
METAAPI_SOURCE_ACCOUNT_ID=
METAAPI_TARGET_ACCOUNT_ID=
# Fallback trading-API host; the account's own region from MetaApi takes priority
METAAPI_REST_BASE_URL=https://mt-client-api-v1.london.agiliumtrade.ai

TELEGRAM_BOT_TOKEN=
# Code to send as "/pair <code>" the first time. Falls back to DASHBOARD_PASSWORD.
TELEGRAM_PAIRING_CODE=
# Dashboard login: user "trader", this password
DASHBOARD_PASSWORD=
DATA_DIR=/data

# Existing CopyFactory route (adopted, never created or overwritten)
COPY_SYMBOL=XAUUSD.f
TARGET_SYMBOL=XAUUSDm
COPYFACTORY_STRATEGY_NAME=Gold Source Strategy
DEFAULT_LOT=0.01

# Monitoring frequency (seconds). Minimum 15; 60 keeps far below MetaApi limits.
MONITOR_POLL_SECONDS=60
COPYFACTORY_REFRESH_SECONDS=60
METAAPI_REST_TIMEOUT_SECONDS=20
TELEGRAM_POLL_TIMEOUT=25
LOG_LEVEL=INFO
